* {
    font-family: 'Comic Sans MS', sans-serif;
    box-sizing: border-box;
}


header,
main {
    width: 70%;
    text-align: center;
}


header {
    background-color: PaleTurquoise;
    border-radius: 20px;
    height: 100px;
    padding: 2%;
}


aside {
    float: right;
    width: 25%;
    height: 700px;
    line-height: 2;
    background-color: PaleTurquoise;
    border-radius: 20px;
    padding: 10px;
    margin: 20px;
}


footer {
    clear: both;
    padding: 10px;
}


section {
    border: 1px dashed DimGray;
    padding: 10px 50px;
    height: 400px;
    overflow: auto;
}


img.miniatura {
    height: 200px;
    padding: 10px;
    opacity: 0.8;
    transition: 1s;
}

img.miniatura:hover {
    opacity: 1;
}
